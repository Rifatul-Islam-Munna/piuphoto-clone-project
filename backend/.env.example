# MongoDB
MONGODB_URL=mongodb://localhost:27017/piuphoto

# JWT
ACCESS_TOKEN=your-super-secret-jwt-key-change-in-production

# Cloudflare R2 (takes priority over MinIO when STORAGE_S3_URL is set)
# Keep the EU jurisdiction endpoint for EU buckets. Bucket may also be set via STORAGE_BUCKET_NAME.
STORAGE_S3_URL=https://<account-id>.eu.r2.cloudflarestorage.com/gallarista
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
# Optional public bucket domain, e.g. https://images.example.com (no bucket suffix).
# Leave blank to return permanent signed backend URLs instead.
STORAGE_PUBLIC_URL=
# Optional fixed public backend origin, recommended behind a reverse proxy.
# Otherwise the upload request origin is used for backend image URLs.
PUBLIC_API_URL=
# Optional stable signing secret for backend image URLs. Defaults to STORAGE_SECRET_KEY.
# Keep this secret unchanged to preserve existing backend image links.
STORAGE_URL_SECRET=

# MinIO (local fallback when STORAGE_S3_URL is empty)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=piuphoto-public-bucket

# Admin Credentials
ADMIN_PHONE=01712345678
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGIN=http://localhost:5173

# Server
PORT=4000

# Qdrant Face Search
QDRANT_URL=http://localhost:6333
FACE_DETECTION_ENDPOINT_URL=PASTE_MY_ENDPOINT_HERE
FACE_CLUSTER_DISTANCE=0.55
FACE_MATCH_DISTANCE=0.95
FACE_SEARCH_SCAN_LIMIT=10000
FAL_KEY=
# Optional: only enable this when you have a public backend webhook URL.
IS_WEBHOOK=false
FAL_WEBHOOK_URL=

# Public link base (optional locally; set your production URL in production)
PUBLIC_APP_URL=http://localhost:5173
GUEST_NOTIFICATION_BATCH_SECONDS=45

# Optional email delivery - leave all blank to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Airpix

# Optional WhatsApp Cloud API - leave blank to disable WhatsApp notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Phase 3 Store / Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional. If blank, secure Stripe API reconciliation verifies payments/refunds.
STRIPE_WEBHOOK_SECRET=
STRIPE_RECONCILE_SECONDS=60
STORE_TOKEN_SECRET=

# Phase 3 analytics/privacy
ANALYTICS_SALT=change-this-to-a-random-secret

# AI review/search metadata
# By default the app uses FAL_KEY with fal-ai/bagel/understand.
MEDIA_AI_CONCURRENCY=2
AI_BLUR_VARIANCE_THRESHOLD=120
